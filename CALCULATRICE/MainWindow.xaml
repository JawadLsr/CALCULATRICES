<Window x:Class="CALCULATRICE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculatrice"
        Width="380"
        Height="680"
        Background="#F3EFE7">

    <Window.Resources>

        <!-- Style appliqué à tous les boutons : coins arrondis et taille du texte -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                BorderThickness="0"
                                Padding="5">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="FontSize" Value="22"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <!-- 7 lignes : l'écran, les fonctions math, puis 5 lignes de boutons -->
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- 4 colonnes de même largeur -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Écran de la calculatrice -->
        <TextBox x:Name="TB_Display"
                 Grid.Row="0"
                 Grid.Column="0"
                 Grid.ColumnSpan="4"
                 Text="0"
                 FontSize="25"
                 Foreground="White"
                 Background="#19192B"
                 HorizontalContentAlignment="Right"
                 VerticalContentAlignment="Center"
                 Margin="10"
                 Padding="10"/>

        <!-- Fonctions mathématiques -->
        <Button Grid.Row="1" Grid.Column="0"
                Content="cos"
                Background="#D9D0BF"
                Margin="5"
                Click="BTN_Cos_Click"/>

        <Button Grid.Row="1" Grid.Column="1"
                Content="sin"
                Background="#D9D0BF"
                Margin="5"
                Click="BTN_Sin_Click"/>

        <Button Grid.Row="1" Grid.Column="2"
                Content="tan"
                Background="#D9D0BF"
                Margin="5"
                Click="BTN_Tan_Click"/>

        <Button Grid.Row="1" Grid.Column="3"
                Content="√"
                Background="#D9D0BF"
                Margin="5"
                Click="BTN_SquareRoot_Click"/>

        <!-- Première ligne de boutons : C, ±, %, ÷ -->
        <Button Grid.Row="2" Grid.Column="0"
                Content="C"
                Background="#D9D0BF"
                Margin="5"
                Click="BTN_Clear_Click"/>

        <!-- Le bouton ± est maintenant relié à BTN_Sign_Click (correction) -->
        <Button Grid.Row="2" Grid.Column="1"
                Content="±"
                Background="#D9D0BF"
                Margin="5"
                Click="BTN_Sign_Click"/>

        <Button Grid.Row="2" Grid.Column="2"
                Content="%"
                Background="#D9D0BF"
                Margin="5"
                Click="BTN_Percent_Click"/>

        <Button Grid.Row="2" Grid.Column="3"
                Content="÷"
                Background="#F15B35"
                Foreground="White"
                Margin="5"
                Click="BTN_Divide_Click"/>

        <!-- Chiffres 7, 8, 9 et multiplication -->
        <Button Grid.Row="3" Grid.Column="0"
                Content="7" Margin="5"
                Click="BTN_Seven_Click"/>

        <Button Grid.Row="3" Grid.Column="1"
                Content="8" Margin="5"
                Click="BTN_Eight_Click"/>

        <Button Grid.Row="3" Grid.Column="2"
                Content="9" Margin="5"
                Click="BTN_Nine_Click"/>

        <Button Grid.Row="3" Grid.Column="3"
                Content="×"
                Background="#F15B35"
                Foreground="White"
                Margin="5"
                Click="BTN_Multiply_Click"/>

        <!-- Chiffres 4, 5, 6 et soustraction -->
        <Button Grid.Row="4" Grid.Column="0"
                Content="4" Margin="5"
                Click="BTN_Four_Click"/>

        <Button Grid.Row="4" Grid.Column="1"
                Content="5" Margin="5"
                Click="BTN_Five_Click"/>

        <Button Grid.Row="4" Grid.Column="2"
                Content="6" Margin="5"
                Click="BTN_Six_Click"/>

        <Button Grid.Row="4" Grid.Column="3"
                Content="-"
                Background="#F15B35"
                Foreground="White"
                Margin="5"
                Click="BTN_Subtract_Click"/>

        <!-- Chiffres 1, 2, 3 et addition -->
        <Button Grid.Row="5" Grid.Column="0"
                Content="1" Margin="5"
                Click="BTN_One_Click"/>

        <Button Grid.Row="5" Grid.Column="1"
                Content="2" Margin="5"
                Click="BTN_Two_Click"/>

        <Button Grid.Row="5" Grid.Column="2"
                Content="3" Margin="5"
                Click="BTN_Three_Click"/>

        <Button Grid.Row="5" Grid.Column="3"
                Content="+"
                Background="#F15B35"
                Foreground="White"
                Margin="5"
                Click="BTN_Add_Click"/>

        <!-- Dernière ligne : 0 (sur 2 colonnes), virgule, égal -->
        <Button Grid.Row="6" Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="0" Margin="5"
                Click="BTN_Zero_Click"/>

        <Button Grid.Row="6" Grid.Column="2"
                Content=","
                Margin="5"
                Click="BTN_Comma_Click"/>

        <Button Grid.Row="6" Grid.Column="3"
                Content="="
                Background="#19192B"
                Foreground="White"
                Margin="5"
                Click="BTN_Equals_Click"/>

    </Grid>
</Window>